generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model SiteSettings {
  id              String   @id @default("default")
  companyName     String   @default("WALESS GROUP")
  domain          String   @default("walessgroup.ae")
  logoUrl         String   @default("/icon.svg")
  phone           String   @default("+971 7 222 868")
  mobile1         String   @default("+971 54 307 2733")
  mobile2         String   @default("+971 54 307 2711")
  address         String   @default("AL DHAIT SOUTH, RAS AL KHAIMAH, UNITED ARAB EMIRATES")
  instagram       String   @default("@waless_group")
  whatsapp1       String   @default("+971543072733")
  whatsapp2       String   @default("+971543072711")
  mapLatitude     Float    @default(25.7533)
  mapLongitude    Float    @default(55.9525)
  mapZoom         Int      @default(14)
  heroHeading     String   @default("ELEVATING AUTOMOTIVE & CORPORATE EXCELLENCE IN UAE")
  heroSubheading  String   @default("WALESS GROUP delivers ultra-luxury bespoke vehicle customization, high-performance tuning, and elite corporate services across Ras Al Khaimah and the UAE.")
  heroImageUrl    String   @default("/uploads/home_page.jpg")
  aboutImageUrl   String   @default("/uploads/gallery__1_.jpg")
  contactImageUrl String   @default("/uploads/gallery__12_.jpg")
  seoTitle        String   @default("WALESS GROUP | Luxury Automotive & Corporate Solutions UAE")
  seoDescription  String   @default("WALESS GROUP is Ras Al Khaimah's premier destination for luxury car customization, detailing, and bespoke corporate solutions. Contact us +971 7 222 868.")
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDesc        String
  detailedDesc     String
  mainImage        String
  additionalImages String   @default("[]")
  features         String   @default("[]")
  priceInfo        String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     String   @default("General")
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("gallery_images")
}

model Booking {
  id              String    @id @default(cuid())
  referenceId     String    @unique
  serviceId       String
  serviceName     String
  fullName        String
  address         String
  phone           String
  description     String?
  requestedDate   String
  status          String    @default("PENDING")
  rejectionReason String?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("bookings")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  category  String   @default("General")
  createdAt DateTime @default(now())

  @@map("media")
}

model AuditLog {
  id            String   @id @default(cuid())
  adminUsername String
  action        String
  entityType    String
  entityId      String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}

model LoyaltyProgramConfig {
  id                String   @id @default("default")
  programName       String   @default("WALESS VIP LOYALTY PASS")
  programTagline    String   @default("BUY 4 SERVICES = 1 FREE BESPOKE FINISH")
  isActive          Boolean  @default(true)
  rewardMode        String   @default("STAMPS") // STAMPS | POINTS
  stampsPerReward   Int      @default(4)
  stampsPerVisit    Int      @default(1)
  pointsPerAed      Float    @default(1.0)
  rewardExpiryDays  Int      @default(365) // 0 for no expiry
  rewardTitle       String   @default("1 FREE BESPOKE FINISH")
  rewardDescription String   @default("Enjoy a complimentary bespoke finish or luxury detailing service after collecting 4 service stamps.")
  termsConditions   String   @default("• Present your digital loyalty pass or member ID upon vehicle arrival at WALESS GROUP.\n• Receive 1 stamp for each qualifying service or maintenance visit.\n• Redeem your free reward once the required stamps have been accumulated.\n• Valid exclusively at WALESS GROUP Al Dhait South, Ras Al Khaimah, UAE.\n• Passes and rewards are non-transferable, cannot be redeemed for cash, and cannot be combined with conflicting promotional discounts.")
  updatedAt         DateTime @updatedAt

  @@map("loyalty_program_config")
}

model LoyaltyCustomer {
  id             String   @id @default(cuid())
  loyaltyId      String   @unique // e.g. "WG-VIP-1029"
  fullName       String
  phone          String   @unique
  email          String?
  plateNumber    String?
  vehicleMake    String?
  vehicleModel   String?
  vehicleYear    String?
  status         String   @default("ACTIVE") // ACTIVE, SUSPENDED
  currentStamps  Int      @default(0)
  lifetimeStamps Int      @default(0)
  currentPoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  qrCodeToken    String   @unique // secure token for QR
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   LoyaltyTransaction[]
  redemptions    LoyaltyRedemption[]

  @@map("loyalty_customers")
}

model LoyaltyReward {
  id              String   @id @default(cuid())
  title           String
  description     String
  requiredStamps  Int      @default(4)
  requiredPoints  Int      @default(0)
  validDays       Int      @default(90)
  isActive        Boolean  @default(true)
  redemptionLimit Int?
  redemptionCount Int      @default(0)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     LoyaltyRedemption[]

  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id               String          @id @default(cuid())
  redemptionCode   String          @unique // e.g. "RDM-78392"
  customerId       String
  customer         LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId         String
  reward           LoyaltyReward   @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  rewardTitle      String
  status           String          @default("COMPLETED") // COMPLETED, REVERSED
  serviceReference String?
  adminUsername    String
  notes            String?
  redeemedAt       DateTime        @default(now())
  reversedAt       DateTime?
  reversedBy       String?

  @@map("loyalty_redemptions")
}

model LoyaltyTransaction {
  id               String          @id @default(cuid())
  customerId       String
  customer         LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type             String          // STAMP_EARNED, STAMP_DEDUCTED, REWARD_UNLOCKED, REWARD_REDEEMED, REWARD_REVERSED, ACCOUNT_CREATED
  amount           Int             // +1, -4, etc.
  balanceAfter     Int
  serviceName      String?
  serviceReference String?
  adminUsername    String?
  notes            String?
  createdAt        DateTime        @default(now())

  @@map("loyalty_transactions")
}

