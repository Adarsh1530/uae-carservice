# WHALESS GROUP Production & Local Environment Variables

# Site URL Configuration
NEXT_PUBLIC_SITE_URL=https://www.walessgroup.ae

# Database connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="postgresql://user:password@localhost:5432/whalessgroup?schema=public"

# Auth Session Secret Key (Min 32 characters)
AUTH_SECRET=your-random-32-character-secret-key-here

# Supabase Storage / S3 Credentials (Optional for production cloud storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Contact Numbers
WHATSAPP_NUMBER_1=+971543072733
WHATSAPP_NUMBER_2=+971543072711

# Maps API Key (Optional if using Mapbox or Google Maps, defaults to OpenStreetMap Leaflet)
NEXT_PUBLIC_MAP_API_KEY=
